# Production build (react-scripts build).
#
# Where the API lives, WITHOUT the /api/v1 prefix — the client adds that to every
# request (see src/api/api.js).
#
# Current deployment: the API is reached at its own host and port.
REACT_APP_API_ORIGIN=http://80.225.239.163:8000

# If the site ends up behind a reverse proxy that forwards /api/v1 to the
# backend, set this EMPTY instead. Requests then go to the same origin the app
# is served from, which also removes the CORS round-trip and keeps cookies
# first-party:
#   REACT_APP_API_ORIGIN=

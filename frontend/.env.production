# Production build (react-scripts build).
#
# Where the API lives, WITHOUT the /api/v1 prefix — the client adds that to every
# request (see src/api/api.js).
#
# Current deployment: the API is reached at its own host and port.
REACT_APP_API_ORIGIN=http://80.225.239.163:8000

# If the site ends up behind a reverse proxy that forwards /api/v1 to the
# backend, set this EMPTY instead. Requests then go to the same origin the app
# is served from, which also removes the CORS round-trip and keeps cookies
# first-party:
#   REACT_APP_API_ORIGIN=

# Where Grafana lives, for the embedded dashboard (GrafanaDashboard.jsx).
#
# This points straight at Grafana, which is the configuration production wants —
# no proxy in the request path. It renders as soon as the Grafana server allows
# framing:
#
#   [security]
#   allow_embedding = true      <- the shipped default is `;allow_embedding = true`,
#                                  and that leading `;` is a comment: it does nothing
#
# Until that is uncommented the browser refuses the frame, and no frontend
# setting can change that — the alternative is to serve Grafana under this app's
# own origin (which is what src/setupProxy.js does for local development).
#
# Also: if this app ever moves to https, Grafana must move too — a browser blocks
# an http iframe inside an https page as mixed content.
REACT_APP_GRAFANA_URL=http://144.24.104.80:3000
REACT_APP_GRAFANA_DASHBOARD_PATH=/d/adsn7p8/agent-info

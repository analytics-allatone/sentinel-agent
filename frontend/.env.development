# Local development (react-scripts start).
#
# Where the API lives, WITHOUT the /api/v1 prefix — the client adds that to every
# request (see src/api/api.js).
#
# Point it at the deployed backend, which is what local development uses today:
REACT_APP_API_ORIGIN=http://80.225.239.163:8000

# To run against a backend on this machine instead, use:
#   REACT_APP_API_ORIGIN=http://localhost:8000
#
# Or leave it EMPTY to call http://localhost:3000/api/v1 and let the dev server's
# proxy (the "proxy" field in package.json) forward it to the backend:
#   REACT_APP_API_ORIGIN=
#
# Changes here need a dev-server restart — CRA reads .env files only at startup.

# Local development (react-scripts start).
#
# Where the API lives, WITHOUT the /api/v1 prefix — the client adds that to every
# request (see src/api/api.js).
#
# Point it at the deployed backend, which is what local development uses today:
REACT_APP_API_ORIGIN=http://80.225.239.163:8000

# To run against a backend on this machine instead, use:
#   REACT_APP_API_ORIGIN=http://localhost:8000
#
# Or leave it EMPTY to call http://localhost:3000/api/v1 and let the dev server
# forward it to the backend (that forwarding now lives in src/setupProxy.js):
#   REACT_APP_API_ORIGIN=
#
# Changes here need a dev-server restart — CRA reads .env files only at startup.

# Where Grafana lives, for the embedded dashboard (GrafanaDashboard.jsx).
#
# ── The one line that switches how the frame reaches Grafana ────────────────
#
#   EMPTY                        -> through this app's own origin (proxy on)
#   http://144.24.104.80:3000    -> straight at the Grafana server (proxy off)
#
# It is EMPTY today because signing in works only this way. Framing is already
# allowed on the server (`allow_embedding = true` is live), but the frame still
# arrives signed-out, and a login inside a CROSS-SITE frame never sticks:
# Grafana's session cookie is SameSite=Lax and a browser will not send a Lax
# cookie back on a cross-site frame request — hence the login loop. Served under
# this app's origin the same cookie is first-party, so the login holds.
#
# Over plain http nothing in the frontend can change that: SameSite=None needs
# Secure, and Secure needs HTTPS.
#
# Once the Grafana server has anonymous access on —
#
#   [auth.anonymous]
#   enabled = true
#
# — no cookie is needed at all. Put the direct URL back on the line below,
# restart the dev server, and the proxy is out of the picture for good.
REACT_APP_GRAFANA_URL=
REACT_APP_GRAFANA_DASHBOARD_PATH=/d/adsn7p8/agent-info

# The Grafana server every proxied request is forwarded to.
GRAFANA_PROXY_TARGET=http://144.24.104.80:3000
